# The fixture project of the end-to-end and golden-master tests; the tests narrow distribs.*.versions
# and packages per test. hello-lib's deb source comes from upstream/hello-lib.git, which the tests
# make (debian/watch), its rpm source from the local server the tests start (@ORIG_BASE@ in
# hello-lib.spec.in).
distribs:
  debian:
    versions: [trixie]
    repository: {path: repositories/debian, url: "http://repo.example.invalid/debian", name: hello, description: Hello test}
    gpg: {file: key.gpg}
  ubuntu:
    versions: [noble]
    repository: {path: repositories/ubuntu, url: "http://repo.example.invalid/ubuntu", name: hello, description: Hello test}
    gpg: {file: key.gpg}
  fedora:
    versions: ['44']
    repository: {path: repositories/fedora, url: "http://repo.example.invalid/fedora", name: hello, description: Hello test}
    gpg: {file: key.gpg}
  opensuse:
    versions: ['16.0', tumbleweed]
    repository: {path: repositories/opensuse, url: "http://repo.example.invalid/opensuse", name: hello, description: Hello test}
    gpg: {file: key.gpg}
  el:
    versions: ['10']
    repository: {path: repositories/el, url: "http://repo.example.invalid/el", name: hello, description: Hello test}
    gpg: {file: key.gpg}
packages:
  hello-lib: {}
  hello-app: {}
  hello-undeclared: {}
  hello-needs-root: {}
  hello-needs-network: {}

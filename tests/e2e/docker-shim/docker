#!/usr/bin/env python3
"""A `docker` for the tests only: drops --user from `docker run`, then runs the real docker.

The builder, as master's pkgbuild, runs its tool containers with --user <uid>:<gid>, which under a
rootless engine maps to a subordinate uid that cannot write the bind mounts (note 164). Without
--user, container root is the invoking user there. The tests put this directory first on PATH
under rootless engines only; Phase 4's runner makes the same choice itself, and this shim goes away
with it.
"""

import os
import sys
from pathlib import Path

# The `docker run` options of the command lines pkgbuild writes that take a separate value, so that
# the image, the first other non-option argument, is found; everything after it is the container's.
VALUE_OPTIONS = {
    '--env',
    '-e',
    '--entrypoint',
    '--mount',
    '--name',
    '--network',
    '--shm-size',
    '--user',
    '-u',
    '--volume',
    '-v',
    '--workdir',
    '-w',
}


def strip_user(args: list[str]) -> list[str]:
    """args without the --user option of a `docker run`, every other command unchanged."""
    if not args or args[0] != 'run':
        return args
    result, i = ['run'], 1
    while i < len(args):
        arg = args[i]
        if not arg.startswith('-'):
            return result + args[i:]
        if arg in ('--user', '-u'):
            i += 2
            continue
        if not arg.startswith(('--user=', '-u=')):
            result.append(arg)
            if arg in VALUE_OPTIONS:
                result.append(args[i + 1])
                i += 1
        i += 1
    return result


def real_docker() -> str:
    """The first docker on PATH that is not this shim."""
    here = Path(__file__).resolve().parent
    for entry in os.environ.get('PATH', '').split(os.pathsep):
        candidate = Path(entry) / 'docker'
        if (
            entry
            and Path(entry).resolve() != here
            and candidate.is_file()
            and os.access(candidate, os.X_OK)
        ):
            return str(candidate)
    sys.exit('docker shim: no docker on PATH besides this shim')


if __name__ == '__main__':
    docker = real_docker()
    os.execv(docker, [docker, *strip_user(sys.argv[1:])])

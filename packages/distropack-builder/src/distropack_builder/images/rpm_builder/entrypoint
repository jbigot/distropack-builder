# Three modes (protocol 4):
#   query   with the specs mounted under /specs, writes for each one under /out/<name>/ what
#           rpmspec says of it: buildrequires, provides, parsed, errors and status;
#   deps    with network: installs the build dependencies of the spec in /src, from the release's
#           repositories and the local repository in /localrepo, and copies /src to /tmp/src; the
#           runner then commits the container to a temporary image;
#   build   from that image, with no network: rpmbuild as an unprivileged user, as mock builds, the
#           rpms moved to /output.

trap 'echo received signal, quitting...; exit 1' INT TERM

set -euo pipefail

if [ -e /usr/lib64/nosync/nosync.so ]
then
	export LD_PRELOAD="/usr/lib64/nosync/nosync.so"
fi

# With /buildenv mounted, what the dependency container installed, sorted, in /buildenv/installed:
# its sha256 is the environment key; when it is DISTROPACK_KNOWN_ENV's, /buildenv/unchanged says
# that nothing is to be built, and the runner does not commit the container.
report_environment() {
	if [ -d /buildenv ]
	then
		printf '%s\n' "$1" | LC_ALL=C sort > /buildenv/installed
		key=$(sha256sum < /buildenv/installed | cut -d' ' -f1)
		if [ -n "${DISTROPACK_KNOWN_ENV:-}" ] && [ "${key}" = "${DISTROPACK_KNOWN_ENV}" ]
		then
			touch /buildenv/unchanged
		fi
		chown -R "$(stat -c '%u:%g' /buildenv)" /buildenv
	fi
}

mode=${1:-}
shift || true

case "${mode}" in
query)
	for spec in /specs/*.spec
	do
		out="/out/$(basename "${spec}" .spec)"
		mkdir -p "${out}"
		status=0
		rpmspec -q --buildrequires "${spec}" > "${out}/buildrequires" 2> "${out}/errors" || status=$?
		if [ "${status}" = 0 ]
		then
			rpmspec -q --provides "${spec}" > "${out}/provides" 2>> "${out}/errors" || status=$?
		fi
		if [ "${status}" = 0 ]
		then
			rpmspec -P "${spec}" > "${out}/parsed" 2>> "${out}/errors" || status=$?
		fi
		echo "${status}" > "${out}/status"
	done
	chown -R "$(stat -c '%u:%g' /out)" /out
	;;
deps)
	set -x
	if [ -d /localrepo/repodata ]
	then
		cat > /tmp/localrepo.repo <<-EOF
			[localrepo]
			name=localrepo
			type=rpm-md
			baseurl=file:///localrepo/
			gpgcheck=0
			enabled=1
			priority=50
		EOF
		dnf config-manager --add-repo /tmp/localrepo.repo \
		|| dnf config-manager addrepo --from-repofile=/tmp/localrepo.repo \
		|| true
	fi
	# the repositories of other packages build.conf names, signature-checked; the local one, at
	# priority 50, wins over them (dnf's default is 99)
	for extra in /extrarepos/*.repo
	do
		if [ -e "${extra}" ]; then cp "${extra}" /etc/yum.repos.d/; fi
	done
	dnf upgrade -y
	dnf builddep -y --setopt=tsflags=nodocs --setopt=install_weak_deps=False --best /src/*.spec
	# the local and extra repositories are not mounted in the build container
	rm -f /etc/yum.repos.d/localrepo.repo
	for extra in /extrarepos/*.repo
	do
		if [ -e "${extra}" ]; then rm -f "/etc/yum.repos.d/$(basename "${extra}")"; fi
	done
	cp -a /src /tmp/src
	mkdir -p /tmp/build/BUILD /tmp/output/src
	report_environment "$(rpm -qa --qf '%{NEVRA}\n')"
	chown -R builder:builder /tmp/src /tmp/build /tmp/output
	;;
build)
	set -x
	setpriv --reuid=builder --regid=builder --init-groups env HOME=/home/builder rpmbuild \
		--define "_topdir    /tmp/build" \
		--define "_tmppath   %{_topdir}" \
		--define "_builddir  %{_topdir}/BUILD" \
		--define "_sourcedir /tmp/src" \
		--define "_specdir   /tmp/src" \
		--define "_rpmdir    /tmp/output" \
		--define "_srcrpmdir %{_rpmdir}/src" \
		-ba /tmp/src/*.spec
	chown -R "$(stat -c '%u:%g' /output)" /tmp/output
	find /tmp/output -type f -name '*.rpm' -execdir mv -t /output -- '{}' '+'
	;;
*)
	echo "usage: entrypoint query | deps | build" >&2
	exit 2
	;;
esac

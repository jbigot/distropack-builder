{#- The default page of a repository. `page` is a distropack_builder.readme.Page. A project's
    README.tpl/README.html.j2 replaces it, or extends it as "distropack/README.html.j2" and
    overrides some of its blocks. -#}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{% block title %}{{ page.description }}: {{ page.distribution_name }} packages{% endblock %}</title>
</head>
<body>
<h1>{{ self.title() }}</h1>
{% block intro -%}
<p>This repository holds the {{ page.distribution_name }} packages of {{ page.description }}, signed
with <a href="{{ page.key_url }}">its key</a>.</p>
{%- endblock %}
{% block install -%}
<h2>Installation</h2>
{% for release in page.releases -%}
<h3>On {{ release.label }}</h3>
{% block release scoped -%}
{% for extra in release.extras -%}
<p>First, the repository of the packages these depend on, {{ extra.name }}, signed by the key of
fingerprint <code>{{ extra.fingerprint }}</code>:</p>
{% if page.family == 'deb' -%}
<pre><code>{% if extra.key_url %}sudo curl -fsSL -o /usr/share/keyrings/{{ extra.name }}.asc {{ extra.key_url }}
{% endif %}sudo tee /etc/apt/sources.list.d/{{ extra.name }}.sources &lt;&lt;'EOF'
Types: deb
URIs: {{ extra.url }}
Suites: {{ extra.suite }}
Components: {{ extra.components | join(' ') }}
Signed-By: /usr/share/keyrings/{{ extra.name }}.asc
EOF</code></pre>
{% elif page.package_manager == 'zypper' -%}
<pre><code>{% if extra.key_url %}sudo rpm --import {{ extra.key_url }}
{% endif %}sudo zypper addrepo --gpgcheck {{ extra.url }} {{ extra.name }}</code></pre>
{% else -%}
<pre><code>sudo tee /etc/yum.repos.d/{{ extra.name }}.repo &lt;&lt;'EOF'
[{{ extra.name }}]
name={{ extra.name }}
baseurl={{ extra.url }}
enabled=1
gpgcheck=1
repo_gpgcheck=1
{% if extra.key_url %}gpgkey={{ extra.key_url }}
{% endif %}EOF</code></pre>
{% endif -%}
{% endfor -%}
{% if page.family == 'deb' -%}
<pre><code>sudo curl -fsSL -o /usr/share/keyrings/{{ page.repository_name }}-archive-keyring.gpg {{ page.key_url }}
sudo tee /etc/apt/sources.list.d/{{ page.repository_name }}.sources &lt;&lt;'EOF'
Types: deb
URIs: {{ release.url }}
Suites: {{ release.codename }}
Components: main
Signed-By: /usr/share/keyrings/{{ page.repository_name }}-archive-keyring.gpg
EOF
sudo apt update</code></pre>
{%- else -%}
{% for host, commands in release.prerequisites -%}
<p>On {{ host }}, first:</p>
<pre><code>{{ commands }}</code></pre>
{% endfor -%}
{% if page.package_manager == 'zypper' -%}
<pre><code>sudo zypper addrepo {{ release.repo_file }}
sudo zypper --gpg-auto-import-keys refresh</code></pre>
<p>zypper imports <a href="{{ page.key_url }}">the key</a> of
<a href="{{ release.url }}">{{ release.url }}</a> at its first refresh.</p>
{%- else -%}
<pre><code>sudo curl -fsSL -o /etc/yum.repos.d/{{ page.repository_name }}.repo {{ release.repo_file }}</code></pre>
<p>dnf asks to trust <a href="{{ page.key_url }}">the key</a> at the first installation from
<a href="{{ release.url }}">{{ release.url }}</a>.</p>
{%- endif %}
{%- endif %}
{%- endblock %}
{% endfor -%}
{%- endblock %}
</body>
</html>
